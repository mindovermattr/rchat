{
  "name": "rchat",
  "private": true,
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/contracts"
  ],
  "scripts": {
    "dev:front": "npm run dev -w client",
    "dev:back": "npm run dev -w server",
    "dev": "concurrently -n client,server \"npm:dev:front\" \"npm:dev:back\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "gen:api": "npm run gen:types --workspace packages/contracts",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
